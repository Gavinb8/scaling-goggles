# gradlew is a POSIX shell script. It must keep LF endings or it fails to
# run on Linux/macOS, and under Git Bash on Windows, regardless of the
# cloning user's core.autocrlf setting.
gradlew text eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf

# Binaries git must never line-ending-convert.
*.jar binary
*.aar binary
*.png binary
*.prg binary
*.der binary
