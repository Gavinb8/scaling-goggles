# Copy to .env (gitignored) and fill in. Never commit real values.

ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5
PORT=8787

# Optional: comma-separated list of API keys this server itself accepts
# from the Android app, so a random phone can't use your bridge if it's
# reachable outside your LAN. Leave empty to disable (fine for a
# localhost-only or LAN-only prototype).
BRIDGE_SHARED_SECRET=
