# Copy this file to secrets.properties (same directory) and fill in your
# own values. secrets.properties is gitignored -- never commit real keys.
#
# You can also set these as environment variables instead (they take
# precedence over this file): ANTHROPIC_API_KEY, CLAUDE_MODEL, BRIDGE_SERVER_URL.

# Get a key from https://console.anthropic.com/ (never put this on the watch).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Any current, available Claude model. Configurable so you can swap models
# without touching code.
CLAUDE_MODEL=claude-sonnet-5

# Optional: if set, the companion app sends prompts to this URL (see
# /server) instead of calling the Anthropic API directly. Useful if you'd
# rather not keep the API key on your phone at all.
BRIDGE_SERVER_URL=

# Only needed if you set BRIDGE_SHARED_SECRET on the /server side too.
BRIDGE_SHARED_SECRET=
